{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 11 (Map 4). Australia, conic equal-area projection (parallels 18°S and 36°S). State fill = international enrolments per 1,000 residents, 2025 (ABS ERP Dec 2025); circles = overseas students at each provider's main campus, 2024 (area linear from zero). Picking a state (tick-boxes above the map, a click on a state, or a click on a provider in chart 12) zooms the map to that state: js/boards.js tweens the 'box' frame and the 't' blend between the old and new view, so the map, circle positions and sizes move smoothly. Circles that would overlap are moved just far enough apart in every view (prep/70_campus_dodge.py), with a hairline back to the campus where they moved more than a few pixels.",
  "usermeta": {
    "aspect": 0.86
  },
  "width": "container",
  "height": 440,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ],
    "fit": {
      "expr": "{type:'Feature',geometry:{type:'MultiPoint',coordinates:[[box[0],box[1]],[(box[0]+box[2])/2,box[1]],[box[2],box[1]],[box[2],(box[1]+box[3])/2],[box[2],box[3]],[(box[0]+box[2])/2,box[3]],[box[0],box[3]],[box[0],(box[1]+box[3])/2]]}}"
    }
  },
  "params": [
    {
      "name": "st",
      "value": ""
    },
    {
      "name": "box",
      "value": [
        112.5,
        -9.5,
        155.0,
        -44.0
      ]
    },
    {
      "name": "vfrom",
      "value": "ALL"
    },
    {
      "name": "vto",
      "value": "ALL"
    },
    {
      "name": "t",
      "value": 1
    }
  ],
  "layer": [
    {
      "data": {
        "url": "geo/au_states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.state",
          "as": "state"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/state_2025.csv",
              "format": {
                "parse": {
                  "per_1000": "number",
                  "enrolments": "number",
                  "population": "number",
                  "share": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "name",
              "per_1000",
              "enrolments",
              "population",
              "share"
            ]
          }
        }
      ],
      "params": [
        {
          "name": "pick",
          "select": {
            "type": "point",
            "fields": [
              "state"
            ],
            "on": "click",
            "clear": "dblclick"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#EEF1EC",
        "strokeWidth": 1.5,
        "cursor": "pointer",
        "clip": true
      },
      "encoding": {
        "color": {
          "field": "per_1000",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "type": "threshold",
            "domain": [
              20,
              30,
              40
            ],
            "range": [
              "#E6ECF5",
              "#C3D1E8",
              "#8FA9D3",
              "#5B7FBD"
            ]
          }
        },
        "opacity": {
          "condition": {
            "test": "st === '' || datum.state === st",
            "value": 1
          },
          "value": 0.3
        },
        "stroke": {
          "condition": {
            "test": "datum.state === st",
            "value": "#14213D"
          },
          "value": "#EEF1EC"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "State"
          },
          {
            "field": "per_1000",
            "title": "Per 1,000 residents",
            "format": ".1f"
          },
          {
            "field": "enrolments",
            "title": "Enrolments 2025",
            "format": ","
          },
          {
            "field": "share",
            "title": "Share of Australia",
            "format": ".0%"
          }
        ]
      }
    },
    {
      "$comment": "A hairline from each circle that had to move back to its campus, with a dot on the campus itself.",
      "data": {
        "url": "data/campus_dodge_2024.csv",
        "format": {
          "parse": {
            "overseas": "number",
            "total": "number",
            "overseas_share": "number",
            "lat": "number",
            "lon": "number",
            "dlon_all": "number",
            "dlat_all": "number",
            "dlon_st": "number",
            "dlat_st": "number",
            "mv_all": "number",
            "mv_st": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "(vfrom === 'ALL' ? datum.dlon_all : vfrom === datum.state ? datum.dlon_st : datum.lon) * (1 - t) + (vto === 'ALL' ? datum.dlon_all : vto === datum.state ? datum.dlon_st : datum.lon) * t",
          "as": "px"
        },
        {
          "calculate": "(vfrom === 'ALL' ? datum.dlat_all : vfrom === datum.state ? datum.dlat_st : datum.lat) * (1 - t) + (vto === 'ALL' ? datum.dlat_all : vto === datum.state ? datum.dlat_st : datum.lat) * t",
          "as": "py"
        },
        {
          "calculate": "((vfrom === 'ALL' || vfrom === datum.state) ? 1 : 0) * (1 - t) + ((vto === 'ALL' || vto === datum.state) ? 1 : 0) * t",
          "as": "vis"
        },
        {
          "filter": "datum.vis > 0.01"
        },
        {
          "calculate": "(vfrom === 'ALL' ? datum.mv_all : vfrom === datum.state ? datum.mv_st : 0) * (1 - t) + (vto === 'ALL' ? datum.mv_all : vto === datum.state ? datum.mv_st : 0) * t",
          "as": "mv"
        },
        {
          "filter": "datum.mv > 5"
        },
        {
          "calculate": "datum.vis * min(1, (datum.mv - 5) / 6)",
          "as": "lo"
        },
        {
          "calculate": "datum.lo * 0.7",
          "as": "lo_rule"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#14213D",
            "strokeWidth": 0.8,
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "px"
            },
            "latitude2": {
              "field": "py"
            },
            "opacity": {
              "field": "lo_rule",
              "type": "quantitative",
              "scale": null
            }
          }
        },
        {
          "mark": {
            "type": "circle",
            "size": 10,
            "color": "#14213D",
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "opacity": {
              "field": "lo",
              "type": "quantitative",
              "scale": null
            }
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/campus_dodge_2024.csv",
        "format": {
          "parse": {
            "overseas": "number",
            "total": "number",
            "overseas_share": "number",
            "lat": "number",
            "lon": "number",
            "dlon_all": "number",
            "dlat_all": "number",
            "dlon_st": "number",
            "dlat_st": "number",
            "mv_all": "number",
            "mv_st": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "stroke": "#EEF1EC",
        "strokeWidth": 0.8,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "px",
          "type": "quantitative"
        },
        "latitude": {
          "field": "py",
          "type": "quantitative"
        },
        "size": {
          "field": "overseas",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              45000
            ],
            "zero": true,
            "nice": false,
            "range": [
              0,
              {
                "expr": "560 * pow(width / 640, 2) * ((vfrom === 'ALL' ? 1 : 1.8) * (1 - t) + (vto === 'ALL' ? 1 : 1.8) * t)"
              }
            ]
          },
          "legend": {
            "title": "OVERSEAS STUDENTS",
            "values": [
              5000,
              20000,
              40000
            ],
            "orient": "bottom-left",
            "direction": "horizontal",
            "symbolType": "circle",
            "symbolFillColor": "#C8371F",
            "symbolOpacity": 0.7,
            "symbolStrokeWidth": 0,
            "labelExpr": "format(datum.value / 1000, 'd') + 'k'"
          }
        },
        "color": {
          "value": "#C8371F"
        },
        "opacity": {
          "field": "op",
          "type": "quantitative",
          "scale": null
        },
        "order": {
          "field": "overseas",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "institution",
            "title": "Provider"
          },
          {
            "field": "campus",
            "title": "Main campus"
          },
          {
            "field": "overseas",
            "title": "Overseas students",
            "format": ","
          },
          {
            "field": "overseas_share",
            "title": "Overseas share",
            "format": ".0%"
          }
        ]
      },
      "transform": [
        {
          "calculate": "(vfrom === 'ALL' ? datum.dlon_all : vfrom === datum.state ? datum.dlon_st : datum.lon) * (1 - t) + (vto === 'ALL' ? datum.dlon_all : vto === datum.state ? datum.dlon_st : datum.lon) * t",
          "as": "px"
        },
        {
          "calculate": "(vfrom === 'ALL' ? datum.dlat_all : vfrom === datum.state ? datum.dlat_st : datum.lat) * (1 - t) + (vto === 'ALL' ? datum.dlat_all : vto === datum.state ? datum.dlat_st : datum.lat) * t",
          "as": "py"
        },
        {
          "calculate": "((vfrom === 'ALL' || vfrom === datum.state) ? 1 : 0) * (1 - t) + ((vto === 'ALL' || vto === datum.state) ? 1 : 0) * t",
          "as": "vis"
        },
        {
          "filter": "datum.vis > 0.01"
        },
        {
          "calculate": "datum.vis * 0.8",
          "as": "op"
        }
      ]
    },
    {
      "$comment": "State labels: code + rate, at hand-placed points inside each state (ACT is labelled offshore with a leader).",
      "data": {
        "url": "data/state_2025.csv",
        "format": {
          "parse": {
            "per_1000": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "{'NSW':146.6,'VIC':141.4,'QLD':144,'WA':121.5,'SA':135,'TAS':146.6,'NT':133.4,'ACT':150.7}[datum.state]",
          "as": "llon"
        },
        {
          "calculate": "{'NSW':-31.6,'VIC':-36.2,'QLD':-22.5,'WA':-26,'SA':-29.5,'TAS':-42.1,'NT':-19.5,'ACT':-37.1}[datum.state]",
          "as": "llat"
        },
        {
          "calculate": "datum.state + ' · ' + format(datum.per_1000, '.1f')",
          "as": "label"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.state === 'ACT'"
            }
          ],
          "mark": {
            "type": "rule",
            "color": "#14213D",
            "strokeWidth": 0.8,
            "opacity": {
              "expr": "(vfrom === 'ALL' ? 1 : 0) * (1 - t) + (vto === 'ALL' ? 1 : 0) * t"
            }
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "llon"
            },
            "latitude2": {
              "field": "llat"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.state !== 'ACT'"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 10,
            "fontWeight": 600,
            "letterSpacing": 0.5,
            "color": "#14213D",
            "align": "left",
            "dx": 2,
            "opacity": {
              "expr": "(vfrom === 'ALL' ? 1 : 0) * (1 - t) + (vto === 'ALL' ? 1 : 0) * t"
            }
          },
          "encoding": {
            "longitude": {
              "field": "llon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "llat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.state === 'ACT'"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 10,
            "fontWeight": 600,
            "letterSpacing": 0.5,
            "color": "#14213D",
            "align": "left",
            "dx": 2,
            "baseline": "top",
            "opacity": {
              "expr": "(vfrom === 'ALL' ? 1 : 0) * (1 - t) + (vto === 'ALL' ? 1 : 0) * t"
            }
          },
          "encoding": {
            "longitude": {
              "field": "llon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "llat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    }
  ]
}