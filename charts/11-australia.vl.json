{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 11 (Map 4). Australia, conic equal-area projection (parallels 18°S and 36°S). State fill = international enrolments per 1,000 residents, 2025 (ABS ERP Dec 2025); circles = overseas students at each university's main campus, 2024 (area linear from zero). Picking a state (form boxes above the map, or a click on the map) zooms the projection to that state through a 'fit' expression, and campus circles move to positions precomputed by prep/70_campus_dodge.py for that view so none overlap; a leader line joins each moved circle to its true campus. The pick is shared with chart 12 through the 'st' signal bridge in js/embed.js.",
  "usermeta": {
    "aspect": 0.86
  },
  "width": "container",
  "height": 440,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ],
    "fit": {
      "expr": "{'ALL':{type:'Feature',geometry:{type:'MultiPoint',coordinates:[[112.5,-9.5],[157.5,-44.0]]}},'NSW':{type:'Feature',geometry:{type:'MultiPoint',coordinates:[[140.8,-28.0],[155.0,-37.6]]}},'VIC':{type:'Feature',geometry:{type:'MultiPoint',coordinates:[[140.8,-33.9],[150.2,-39.3]]}},'QLD':{type:'Feature',geometry:{type:'MultiPoint',coordinates:[[137.8,-10.5],[153.8,-29.3]]}},'WA':{type:'Feature',geometry:{type:'MultiPoint',coordinates:[[112.8,-13.5],[129.2,-35.3]]}},'SA':{type:'Feature',geometry:{type:'MultiPoint',coordinates:[[128.8,-25.8],[141.2,-38.2]]}},'TAS':{type:'Feature',geometry:{type:'MultiPoint',coordinates:[[143.6,-39.4],[148.6,-43.8]]}},'NT':{type:'Feature',geometry:{type:'MultiPoint',coordinates:[[128.8,-10.8],[138.2,-26.2]]}},'ACT':{type:'Feature',geometry:{type:'MultiPoint',coordinates:[[148.7,-35.05],[149.45,-36.0]]}}}[st === '' ? 'ALL' : st]"
    }
  },
  "params": [
    {
      "name": "st",
      "value": ""
    }
  ],
  "layer": [
    {
      "data": {
        "url": "geo/au_states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.state",
          "as": "state"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/state_2025.csv",
              "format": {
                "parse": {
                  "per_1000": "number",
                  "enrolments": "number",
                  "population": "number",
                  "share": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "name",
              "per_1000",
              "enrolments",
              "population",
              "share"
            ]
          }
        }
      ],
      "params": [
        {
          "name": "pick",
          "select": {
            "type": "point",
            "fields": [
              "state"
            ],
            "on": "click",
            "clear": "dblclick"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#EEF1EC",
        "strokeWidth": 1.5,
        "cursor": "pointer",
        "clip": true
      },
      "encoding": {
        "color": {
          "field": "per_1000",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "type": "threshold",
            "domain": [
              20,
              30,
              40
            ],
            "range": [
              "#E6ECF5",
              "#C3D1E8",
              "#8FA9D3",
              "#5B7FBD"
            ]
          }
        },
        "opacity": {
          "condition": {
            "test": "st === '' || datum.state === st",
            "value": 1
          },
          "value": 0.3
        },
        "stroke": {
          "condition": {
            "test": "datum.state === st",
            "value": "#14213D"
          },
          "value": "#EEF1EC"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "State"
          },
          {
            "field": "per_1000",
            "title": "Per 1,000 residents",
            "format": ".1f"
          },
          {
            "field": "enrolments",
            "title": "Enrolments 2025",
            "format": ","
          },
          {
            "field": "share",
            "title": "Share of Australia",
            "format": ".0%"
          }
        ]
      }
    },
    {
      "$comment": "Leader lines and true-location dots for circles that were nudged apart.",
      "data": {
        "url": "data/campus_dodge_2024.csv",
        "format": {
          "parse": {
            "overseas": "number",
            "total": "number",
            "overseas_share": "number",
            "lat": "number",
            "lon": "number",
            "dlat": "number",
            "dlon": "number",
            "moved_px": "number",
            "lab_lon": "number",
            "lab_lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.view === (st === '' ? 'ALL' : st)"
        },
        {
          "filter": "datum.moved_px > 3"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#14213D",
            "strokeWidth": 0.7,
            "opacity": 0.7,
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "dlon"
            },
            "latitude2": {
              "field": "dlat"
            }
          }
        },
        {
          "mark": {
            "type": "circle",
            "size": 7,
            "color": "#14213D",
            "opacity": 1,
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/campus_dodge_2024.csv",
        "format": {
          "parse": {
            "overseas": "number",
            "total": "number",
            "overseas_share": "number",
            "lat": "number",
            "lon": "number",
            "dlat": "number",
            "dlon": "number",
            "moved_px": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "stroke": "#EEF1EC",
        "strokeWidth": 0.8,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "dlon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "dlat",
          "type": "quantitative"
        },
        "size": {
          "field": "overseas",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              45000
            ],
            "range": [
              0,
              {
                "expr": "900 * pow(width / 640, 2) * (st === '' ? 1 : 2.2)"
              }
            ],
            "zero": true,
            "nice": false
          },
          "legend": {
            "title": "OVERSEAS STUDENTS PER CAMPUS",
            "values": [
              5000,
              20000,
              40000
            ],
            "orient": "bottom-left",
            "direction": "horizontal",
            "symbolType": "circle",
            "symbolFillColor": "#C8371F",
            "symbolOpacity": 0.7,
            "symbolStrokeWidth": 0,
            "labelExpr": "format(datum.value / 1000, 'd') + 'k'"
          }
        },
        "color": {
          "value": "#C8371F"
        },
        "opacity": {
          "value": 0.78
        },
        "order": {
          "field": "overseas",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "institution",
            "title": "Provider"
          },
          {
            "field": "campus",
            "title": "Main campus"
          },
          {
            "field": "overseas",
            "title": "Overseas students",
            "format": ","
          },
          {
            "field": "overseas_share",
            "title": "Overseas share",
            "format": ".0%"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.view === (st === '' ? 'ALL' : st)"
        }
      ]
    },
    {
      "$comment": "State views: every provider named. Lone campuses are labelled beside their circle; city clusters get a stacked column of names with leader lines (positions from prep/70_campus_dodge.py).",
      "data": {
        "url": "data/campus_dodge_2024.csv",
        "format": {
          "parse": {
            "overseas": "number",
            "total": "number",
            "overseas_share": "number",
            "lat": "number",
            "lon": "number",
            "dlat": "number",
            "dlon": "number",
            "moved_px": "number",
            "lab_lon": "number",
            "lab_lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "st !== '' && datum.view === st && isValid(datum.lab_lon)"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.lab_lead === 'True' || datum.lab_lead === true"
            }
          ],
          "mark": {
            "type": "rule",
            "color": "#14213D",
            "strokeWidth": 0.6,
            "opacity": 0.55,
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "dlon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "dlat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "lab_lon"
            },
            "latitude2": {
              "field": "lab_lat"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "baseline": "middle",
            "fontSize": 10.5,
            "fontWeight": 600,
            "color": "#14213D",
            "clip": true,
            "align": {
              "expr": "datum.lab_align"
            },
            "dx": {
              "expr": "(datum.lab_lead === 'True' || datum.lab_lead === true) ? (datum.lab_align === 'left' ? 3 : -3) : 0"
            }
          },
          "encoding": {
            "longitude": {
              "field": "lab_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lab_lat",
              "type": "quantitative"
            },
            "text": {
              "field": "short_name"
            }
          }
        }
      ]
    },
    {
      "$comment": "State labels: code + rate, at hand-placed points inside each state (ACT is labelled offshore with a leader).",
      "data": {
        "url": "data/state_2025.csv",
        "format": {
          "parse": {
            "per_1000": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "{'NSW':146.6,'VIC':141.4,'QLD':144,'WA':121.5,'SA':135,'TAS':146.6,'NT':133.4,'ACT':151.9}[datum.state]",
          "as": "llon"
        },
        {
          "calculate": "{'NSW':-31.6,'VIC':-36.2,'QLD':-22.5,'WA':-26,'SA':-29.5,'TAS':-42.1,'NT':-19.5,'ACT':-39.4}[datum.state]",
          "as": "llat"
        },
        {
          "calculate": "datum.state + ' · ' + format(datum.per_1000, '.1f')",
          "as": "label"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.state === 'ACT'"
            },
            {
              "filter": "st === ''"
            }
          ],
          "mark": {
            "type": "rule",
            "color": "#14213D",
            "strokeWidth": 0.8
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "llon"
            },
            "latitude2": {
              "field": "llat"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.state !== 'ACT'"
            },
            {
              "filter": "st === ''"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 10,
            "fontWeight": 600,
            "letterSpacing": 0.5,
            "color": "#14213D",
            "align": "left",
            "dx": 2
          },
          "encoding": {
            "longitude": {
              "field": "llon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "llat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            },
            "opacity": {
              "condition": {
                "test": "st === '' || datum.state === st",
                "value": 1
              },
              "value": 0.3
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.state === 'ACT'"
            },
            {
              "filter": "st === ''"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 10,
            "fontWeight": 600,
            "letterSpacing": 0.5,
            "color": "#14213D",
            "align": "right",
            "dx": 0,
            "baseline": "top"
          },
          "encoding": {
            "longitude": {
              "field": "llon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "llat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            },
            "opacity": {
              "condition": {
                "test": "st === '' || datum.state === st",
                "value": 1
              },
              "value": 0.3
            }
          }
        }
      ]
    }
  ]
}