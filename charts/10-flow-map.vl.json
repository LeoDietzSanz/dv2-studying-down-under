{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 10 (Map 3). Flow map with ribbons: for each country picked on the departures board (China and India to start; up to five), one ribbon as wide as its students runs towards Australia and splits into one branch per state capital, each as wide as the students who go there. Ribbons are polygons built in prep/60_flow_paths.py, so branches add up to the trunk exactly. Azimuthal equidistant projection centred on 110°E. Colombia, Brazil and the US enter from the Pacific edge; Kenya from the Indian Ocean edge. Routes under 1,000 students omitted.",
  "usermeta": {
    "aspect": 0.92
  },
  "width": "container",
  "height": 600,
  "projection": {
    "type": "azimuthalEquidistant",
    "rotate": [
      -110,
      2,
      0
    ],
    "fit": {
      "type": "Feature",
      "geometry": {
        "type": "MultiPoint",
        "coordinates": [
          [
            69,
            47
          ],
          [
            170,
            47
          ],
          [
            170,
            -46
          ],
          [
            69,
            -46
          ]
        ]
      }
    }
  },
  "params": [
    {
      "name": "picked",
      "value": [
        "CHN",
        "IND",
        "",
        "",
        ""
      ]
    }
  ],
  "layer": [
    {
      "data": {
        "graticule": {
          "step": [
            15,
            15
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#C9D0D8",
        "strokeWidth": 0.6,
        "strokeDash": [
          2,
          3
        ],
        "filled": false,
        "clip": true
      }
    },
    {
      "data": {
        "url": "geo/world_countries.topo.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.iso3 !== 'AUS'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#DCE2DA",
        "stroke": "#EEF1EC",
        "strokeWidth": 0.6,
        "clip": true
      }
    },
    {
      "data": {
        "url": "geo/au_states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#D1D8CE",
        "stroke": "#EEF1EC",
        "strokeWidth": 1.2,
        "clip": true
      }
    },
    {
      "$comment": "Ribbons for the picked countries (polygons from prep/60_flow_paths.py): a trunk as wide as the country's students, cut at the split into one branch per capital, so branch widths add up to the trunk exactly. Colour = the slot the country occupies on the departures board.",
      "data": {
        "url": "data/flow_ribbons_2025.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.iso3",
          "as": "iso3"
        },
        {
          "filter": "indexof(picked, datum.iso3) >= 0"
        },
        {
          "calculate": "['#2F5FA7','#C8371F','#C99400','#13A39A','#9E5BD0'][indexof(picked, datum.iso3)]",
          "as": "ink"
        },
        {
          "calculate": "datum.properties.part === 'trunk' ? datum.properties.country + ' → Australia' : datum.properties.country + ' → ' + datum.properties.city",
          "as": "route"
        },
        {
          "calculate": "datum.properties.enrolments",
          "as": "students"
        },
        {
          "calculate": "datum.properties.share",
          "as": "share"
        }
      ],
      "mark": {
        "type": "geoshape",
        "strokeWidth": 0,
        "opacity": 0.82,
        "cursor": "pointer",
        "clip": true
      },
      "encoding": {
        "fill": {
          "field": "ink",
          "type": "nominal",
          "scale": null
        },
        "tooltip": [
          {
            "field": "route",
            "title": "Route"
          },
          {
            "field": "students",
            "title": "Students",
            "format": ","
          },
          {
            "field": "share",
            "title": "Share of that country",
            "format": ".0%"
          }
        ]
      }
    },
    {
      "$comment": "State capitals: ring + airport code.",
      "data": {
        "url": "geo/au_state_capitals.csv",
        "format": {
          "parse": {
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "{'NSW':'SYD','VIC':'MEL','QLD':'BNE','WA':'PER','SA':'ADL','ACT':'CBR','TAS':'HBA','NT':'DRW'}[datum.state]",
          "as": "code"
        },
        {
          "calculate": "{'SYD':[7,-6,'left'],'MEL':[2,13,'left'],'BNE':[7,0,'left'],'PER':[-7,0,'right'],'ADL':[-7,0,'right'],'CBR':[-6,9,'right'],'HBA':[7,0,'left'],'DRW':[7,-4,'left']}[datum.code]",
          "as": "p"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 44,
            "fill": "#EEF1EC",
            "stroke": "#14213D",
            "strokeWidth": 1.6,
            "opacity": 1
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 10,
            "fontWeight": 600,
            "letterSpacing": 0.8,
            "color": "#14213D",
            "dx": {
              "expr": "datum.p[0]"
            },
            "dy": {
              "expr": "datum.p[1]"
            },
            "align": {
              "expr": "datum.p[2]"
            },
            "baseline": "middle"
          },
          "encoding": {
            "text": {
              "field": "code"
            }
          }
        }
      ]
    },
    {
      "$comment": "Each picked country's largest branch, labelled with its share, set out to sea beside the capital; labels at the same capital stack. On narrow screens the labels move into a list in the Indian Ocean, each naming its destination.",
      "data": {
        "url": "data/flow_origins_2025.csv",
        "format": {
          "parse": {
            "lon": "number",
            "lat": "number",
            "students": "number",
            "top_share": "number",
            "top_lon": "number",
            "top_lat": "number",
            "rank": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "indexof(picked, datum.iso3) >= 0"
        },
        {
          "calculate": "['#2F5FA7','#C8371F','#C99400','#13A39A','#9E5BD0'][indexof(picked, datum.iso3)]",
          "as": "ink"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "k"
            }
          ],
          "groupby": [
            "top_code"
          ],
          "sort": [
            {
              "field": "students",
              "order": "descending"
            }
          ]
        },
        {
          "calculate": "width < 560 ? [0, 0, 'left', 0] : {'SYD':[22,8,'left',1],'BNE':[22,-8,'left',-1],'MEL':[-14,26,'right',1],'ADL':[-14,18,'right',1],'PER':[-16,-10,'right',-1],'CBR':[22,10,'left',1],'HBA':[16,10,'left',1],'DRW':[14,-14,'left',-1]}[datum.top_code]",
          "as": "p"
        },
        {
          "calculate": "format(datum.top_share, '.0%') + ' of ' + datum.iso3 + (width < 560 ? ' → ' + datum.top_code : '')",
          "as": "t"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "kk"
            }
          ],
          "sort": [
            {
              "field": "students",
              "order": "descending"
            }
          ]
        },
        {
          "calculate": "width < 560 ? 76 : datum.top_lon",
          "as": "x_lon"
        },
        {
          "calculate": "width < 560 ? -18 - (datum.kk - 1) * 3.2 : datum.top_lat",
          "as": "x_lat"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "x_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "x_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "fontSize": 11.5,
            "fontWeight": 700,
            "stroke": "#EEF1EC",
            "strokeWidth": 4,
            "strokeJoin": "round",
            "color": "#EEF1EC",
            "dx": {
              "expr": "datum.p[0]"
            },
            "dy": {
              "expr": "datum.p[1] + (datum.k - 1) * 15 * datum.p[3]"
            },
            "align": {
              "expr": "datum.p[2]"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11.5,
            "fontWeight": 700,
            "dx": {
              "expr": "datum.p[0]"
            },
            "dy": {
              "expr": "datum.p[1] + (datum.k - 1) * 15 * datum.p[3]"
            },
            "align": {
              "expr": "datum.p[2]"
            }
          },
          "encoding": {
            "color": {
              "field": "ink",
              "type": "nominal",
              "scale": null
            }
          }
        }
      ]
    },
    {
      "$comment": "Origins as flap tiles; a picked country's tile takes its board colour. Clicking a tile or a ribbon toggles the country (js/boards.js).",
      "data": {
        "url": "data/flow_origins_2025.csv",
        "format": {
          "parse": {
            "lon": "number",
            "lat": "number",
            "students": "number",
            "top_share": "number",
            "top_lon": "number",
            "top_lat": "number",
            "rank": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "indexof(picked, datum.iso3) >= 0 ? ['#2F5FA7','#C8371F','#C99400','#13A39A','#9E5BD0'][indexof(picked, datum.iso3)] : '#5D6878'",
          "as": "ink"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "country",
            "title": "From"
          },
          {
            "field": "students",
            "title": "Students 2025",
            "format": ","
          },
          {
            "field": "top_city",
            "title": "Main destination"
          },
          {
            "field": "top_share",
            "title": "Share there",
            "format": ".0%"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "shape": "M-1.5,-0.85H1.5V0.85H-1.5Z",
            "size": {
              "expr": "width < 560 ? 200 : 400"
            },
            "filled": true,
            "opacity": 1,
            "cursor": "pointer"
          },
          "encoding": {
            "color": {
              "field": "ink",
              "type": "nominal",
              "scale": null
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": {
              "expr": "width < 560 ? 7.5 : 10"
            },
            "fontWeight": 600,
            "letterSpacing": 0.8,
            "color": "#F3F1E8",
            "cursor": "pointer"
          },
          "encoding": {
            "text": {
              "field": "iso3"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.via !== '' && isValid(datum.via)"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 9,
            "fontWeight": 600,
            "color": "#4D5A70",
            "dy": -15,
            "opacity": {
              "expr": "width < 560 ? 0 : 1"
            }
          },
          "encoding": {
            "text": {
              "field": "via"
            }
          }
        }
      ]
    }
  ]
}